#!/bin/bash
# postinst for duckbotos-cua-bridge
# Installs trycua/cua as VM orchestrator and optional computer-use backend

set -e

case "$1" in
    configure)
        echo "[duckbotos-cua-bridge] Installing trycua/cua..."

        # Install Python packages
        if command -v pip3 >/dev/null 2>&1; then
            pip3 install --break-system-packages --quiet cua 2>&1 | tail -3 || true
            pip3 install --break-system-packages --quiet cua-driver 2>&1 | tail -3 || true
            pip3 install --break-system-packages --quiet cua-sandbox 2>&1 | tail -3 || true
        fi

        # Install cua-driver binary
        if command -v curl >/dev/null 2>&1; then
            curl -fsSL https://raw.githubusercontent.com/trycua/cua/main/libs/cua-driver/scripts/install.sh | bash 2>&1 | tail -5 || true
        fi

        # CLI wrapper: cua
        cat > /usr/local/bin/cua << 'CUAWRAP'
#!/bin/bash
# trycua/cua CLI wrapper for DuckBotOS
exec python3 -m cua "$@"
CUAWRAP
        chmod +x /usr/local/bin/cua

        # Wire into Hermes + OpenClaw — they use the same ~/.X/mcp.json format
        REAL_USER=$(getent passwd | awk -F: '$3 >= 1000 {print $1; exit}')
        REAL_HOME=$(getent passwd | awk -F: '$3 >= 1000 {print $6; exit}')
        for cfg_dir in "$REAL_HOME/.hermes" "$REAL_HOME/.openclaw"; do
            cfg_path="$cfg_dir/mcp.json"
            [ -n "$REAL_USER" ] || continue
            mkdir -p "$cfg_dir"
            chown -R "$REAL_USER:$REAL_USER" "$cfg_dir" 2>/dev/null || true
            [ -f "$cfg_path" ] || echo '{}' > "$cfg_path"
            chown "$REAL_USER:$REAL_USER" "$cfg_path" 2>/dev/null || true
            python3 - << PYEOF
import json
with open('$cfg_path') as f:
    data = json.load(f)
if 'mcpServers' not in data:
    data['mcpServers'] = {}
data['mcpServers']['cua-driver'] = {
    'command': 'cua-driver',
    'args': ['mcp'],
    'env': {},
    'transport': 'stdio',
    'startup_timeout_sec': 20,
    'tool_timeout_sec': 60,
    'description': 'trycua/cua bridge - VM orchestration + Linux computer-use backend'
}
with open('$cfg_path', 'w') as f:
    json.dump(data, f, indent=2)
print('[duckbotos-cua-bridge] cua-driver registered')
PYEOF
        done

        echo ""
        echo "✅ trycua/cua installed"
        echo "   CLI: cua, cua-driver mcp"
        echo "   VM orchestration: cua-sandbox"
        echo "   Computer-use backend: cua-driver"
        echo "   Reference: https://github.com/trycua/cua"
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        ;;
esac
