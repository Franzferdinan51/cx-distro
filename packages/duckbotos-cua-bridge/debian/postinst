#!/bin/bash
# postinst for duckbotos-cua-bridge
# Installs trycua/cua as VM orchestrator and optional computer-use backend

set -e

case "$1" in
    configure)
        echo "[duckbotos-cua-bridge] Installing trycua/cua..."

        # Install Python packages
        if command -v pip3 >/dev/null 2>&1; then
            pip3 install --break-system-packages --quiet cua 2>&1 | tail -3 || true
            pip3 install --break-system-packages --quiet cua-driver 2>&1 | tail -3 || true
            pip3 install --break-system-packages --quiet cua-sandbox 2>&1 | tail -3 || true
        fi

        # Install cua-driver binary
        if command -v curl >/dev/null 2>&1; then
            curl -fsSL https://raw.githubusercontent.com/trycua/cua/main/libs/cua-driver/scripts/install.sh | bash 2>&1 | tail -5 || true
        fi

        # CLI wrapper: cua
        cat > /usr/local/bin/cua << 'CUAWRAP'
#!/bin/bash
# trycua/cua CLI wrapper for DuckBotOS
exec python3 -m cua "$@"
CUAWRAP
        chmod +x /usr/local/bin/cua

        # Wire into OpenClaw as a second computer-use backend
        OPENCLAW_CFG="/var/lib/openclaw/workspace/openclaw.json"
        if [ -d "/var/lib/openclaw/workspace" ]; then
            mkdir -p "/var/lib/openclaw/workspace"
            if [ ! -f "$OPENCLAW_CFG" ]; then
                echo '{}' > "$OPENCLAW_CFG"
            fi
            python3 - << 'PYEOF'
import json
cfg = '/var/lib/openclaw/workspace/openclaw.json'
with open(cfg) as f:
    cfg_data = json.load(f)
if 'plugins' not in cfg_data:
    cfg_data['plugins'] = {}
if 'entries' not in cfg_data['plugins']:
    cfg_data['plugins']['entries'] = {}
cfg_data['plugins']['entries']['cua-driver'] = {
    'enabled': True,
    'config': {
        'command': 'cua-driver',
        'args': ['mcp'],
        'transport': 'stdio',
        'name': 'cua-driver',
        'description': 'trycua/cua bridge — VM orchestration + Linux backend for computer-use',
        'repository': 'https://github.com/trycua/cua',
    }
}
with open(cfg, 'w') as f:
    json.dump(cfg_data, f, indent=2)
print('[duckbotos-cua-bridge] cua-driver registered in openclaw.json')
PYEOF
        fi

        echo ""
        echo "✅ trycua/cua installed"
        echo "   CLI: cua, cua-driver mcp"
        echo "   VM orchestration: cua-sandbox"
        echo "   Computer-use backend: cua-driver"
        echo "   Reference: https://github.com/trycua/cua"
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        ;;
esac
