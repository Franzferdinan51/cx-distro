#!/bin/bash
# postinst for duckbotos-computer-use

set -e

case "$1" in
    configure)
        # Enable and start the computer-use-linux MCP service
        if command -v systemctl >/dev/null 2>&1; then
            systemctl --user daemon-reload 2>/dev/null || true
            systemctl --user enable computer-use-linux.service 2>/dev/null || true
            systemctl --user start computer-use-linux.service 2>/dev/null || true
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        ;;
esac